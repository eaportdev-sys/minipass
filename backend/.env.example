PORT=3001
APPS_DIR=../apps
# Webhook secret seed - per-app tokens derived from this + app id
WEBHOOK_SECRET=change-me
# For tunnel-add.sh
TUNNEL_TOKEN=
BASE_DOMAIN=example.com
# GitHub handshake (one connect, every repo works). Register an OAuth App at
# github.com Settings -> Developer settings, callback <PANEL_URL>/api/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL of this panel (for OAuth callback + auto webhook payload URLs)
PANEL_URL=http://SERVER_IP:3001
